{
  "action_id": "send_invoice",
  "version": 1,
  "name": "Send invoice",
  "integration": "quickbooks",
  "integration_name": "QuickBooks",
  "mcp_tool": "quickbooks_send_invoice",
  "description": "Email an existing tax invoice to the customer.",
  "side_effect_class": "side_effecting",
  "parameters": {
    "type": "object",
    "properties": {
      "invoice_number": {
        "type": "string",
        "pattern": "^INV-[0-9]{4}$",
        "description": "Invoice number in the INV-nnnn format."
      },
      "amount": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "Invoice amount in AED."
      },
      "recipient_email": {
        "type": "string",
        "format": "email",
        "description": "Customer email that receives the invoice."
      },
      "order_number": {
        "type": "string",
        "pattern": "^#?[0-9]{3,6}$",
        "description": "Optional source order, recorded for traceability."
      }
    },
    "required": ["invoice_number", "amount", "recipient_email"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "invoice_number": { "type": "string" },
      "status": { "type": "string", "enum": ["sent", "failed"] },
      "recipient_email": { "type": "string", "format": "email" },
      "sent_at": { "type": "string", "format": "date-time" }
    },
    "required": ["invoice_number", "status", "recipient_email", "sent_at"]
  },
  "verifier": {
    "kind": "read_back",
    "action_id": "get_invoice",
    "arguments": { "invoice_number": "$args.invoice_number" },
    "assert": [
      { "field": "status", "equals": "sent" },
      { "field": "recipient_email", "equals": "$args.recipient_email" },
      { "field": "amount", "equals": "$args.amount" }
    ]
  },
  "example": {
    "arguments": {
      "invoice_number": "INV-2210",
      "amount": 349.0,
      "recipient_email": "sara.ali@example.com",
      "order_number": "#1042"
    },
    "result": {
      "invoice_number": "INV-2210",
      "status": "sent",
      "recipient_email": "sara.ali@example.com",
      "sent_at": "2026-10-26T10:15:00+04:00"
    }
  }
}

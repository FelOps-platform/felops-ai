{
  "action_id": "get_case",
  "version": 1,
  "name": "Get case",
  "integration": "salesforce",
  "integration_name": "Salesforce",
  "mcp_tool": "salesforce_get_case",
  "description": "Read a support case with its status and subject.",
  "side_effect_class": "read_only",
  "parameters": {
    "type": "object",
    "properties": {
      "case_id": {
        "type": "string",
        "pattern": "^CASE-[0-9]{4}$",
        "description": "Case identifier in the CASE-nnnn format."
      }
    },
    "required": ["case_id"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "case_id": { "type": "string" },
      "status": { "type": "string", "enum": ["open", "pending", "closed"] },
      "subject": { "type": "string" },
      "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
      "updated_at": { "type": "string", "format": "date-time" }
    },
    "required": ["case_id", "status", "subject", "priority"]
  },
  "verifier": {
    "kind": "self_read",
    "action_id": "get_case",
    "arguments": { "case_id": "$args.case_id" },
    "assert": [{ "field": "status", "equals": "$result.status" }]
  },
  "example": {
    "arguments": { "case_id": "CASE-5512" },
    "result": {
      "case_id": "CASE-5512",
      "status": "open",
      "subject": "Damaged lamp on order #1042",
      "priority": "high",
      "updated_at": "2026-10-26T11:40:00+04:00"
    }
  }
}

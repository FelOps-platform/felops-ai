{
  "action_id": "lookup_order",
  "version": 1,
  "name": "Lookup order",
  "integration": "shopify",
  "integration_name": "Shopify",
  "mcp_tool": "shopify_lookup_order",
  "description": "Read an order with its fulfillment, payment and refund status by order number.",
  "side_effect_class": "read_only",
  "parameters": {
    "type": "object",
    "properties": {
      "order_number": {
        "type": "string",
        "pattern": "^#?[0-9]{3,6}$",
        "description": "Order number, with or without the leading #."
      }
    },
    "required": ["order_number"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "order_number": { "type": "string" },
      "status": {
        "type": "string",
        "enum": ["pending", "fulfilled", "shipped", "delivered", "cancelled"]
      },
      "tracking_number": { "type": ["string", "null"] },
      "total": { "type": "number" },
      "currency": { "const": "AED" },
      "refund_status": {
        "type": "string",
        "enum": ["none", "pending", "completed"]
      },
      "refund_amount": { "type": ["number", "null"] }
    },
    "required": ["order_number", "status", "currency", "refund_status"]
  },
  "verifier": {
    "kind": "self_read",
    "action_id": "lookup_order",
    "arguments": { "order_number": "$args.order_number" },
    "assert": [
      { "field": "status", "equals": "$result.status" },
      { "field": "tracking_number", "equals": "$result.tracking_number" }
    ]
  },
  "example": {
    "arguments": { "order_number": "#1042" },
    "result": {
      "order_number": "#1042",
      "status": "shipped",
      "tracking_number": "TRK8812",
      "total": 349.0,
      "currency": "AED",
      "refund_status": "none",
      "refund_amount": null
    }
  }
}

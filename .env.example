POSTGRES_USER=felops
POSTGRES_PASSWORD=felops_dev
POSTGRES_DB=felops
BACKEND_IDENTITY_TOKEN=dev_backend_token
AI_IDENTITY_TOKEN=dev_ai_token
BACKEND_URL=http://mock-backend:8080

# Host-side tools and the live Qdrant test; docker compose sets this for api.
QDRANT_URL=http://localhost:6333

# Docker Compose embedding profile ("cpu" or "gpu").
COMPOSE_PROFILES=cpu
# Host-side only: used by the live TEI test via the published port.
# docker-compose.yml hardcodes http://tei:80 for the api container.
EMBEDDING_URL=http://localhost:8081
EMBEDDING_MODEL_ID=BAAI/bge-m3

# Max tokens per TEI batch. With --auto-truncate this is also the per-input
# cap: TEI truncates each text to min(model max, this value). 2048 keeps
# first-run CPU warmup memory low but silently drops BGE-M3 context above
# 2048 tokens. Raise it (up to 8192) on GPU/high-RAM hosts where full context
# matters more than warmup memory.
TEI_MAX_BATCH_TOKENS=2048

# Set TEI_GPU_TAG to match your NVIDIA GPU architecture when using --profile gpu.
# Ampere datacenter (A100) -> 1.10 (default for server/prod)
# Ampere consumer/workstation (RTX 2050, RTX 30xx, A10) -> 86-1.10
# Ada (RTX 40xx) -> 89-1.10
# Turing (T4) -> turing-1.10
TEI_GPU_TAG=1.10

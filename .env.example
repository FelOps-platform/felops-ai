POSTGRES_USER=felops
POSTGRES_PASSWORD=felops_dev
POSTGRES_DB=felops
BACKEND_IDENTITY_TOKEN=dev_backend_token
AI_IDENTITY_TOKEN=dev_ai_token
BACKEND_URL=http://mock-backend:8080

# Host-side tools and the live Qdrant test; docker compose sets this for api.
QDRANT_URL=http://localhost:6333

# Docker Compose embedding profile ("cpu" or "gpu") and host-side TEI URL.
COMPOSE_PROFILES=cpu
EMBEDDING_URL=http://localhost:8081
EMBEDDING_MODEL_ID=BAAI/bge-m3

# Max tokens per TEI batch. TEI warms up with this many tokens, so on CPU hosts
# with ~16 GB RAM the default 16384 can be OOM-killed; 2048 is a safe dev value.
# Raise it (up to 8192) on machines with more memory or with the GPU profile.
TEI_MAX_BATCH_TOKENS=2048

# Set TEI_GPU_TAG to match your NVIDIA GPU architecture when using --profile gpu
# (e.g. 1.10 Ampere A100, 86-1.10 Ampere RTX 30xx/A10, 89-1.10 Ada RTX 40xx, turing-1.10 T4).
TEI_GPU_TAG=1.10
